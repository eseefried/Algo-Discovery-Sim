# Use the hackathon key. Never commit the populated .env file.
CLAUDE_HACKATHON_API=
CLAUDE_MODEL=claude-fable-5-1
# Optional, only for an explicitly trusted Anthropic-compatible endpoint:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MAX_TOKENS=8192
CLAUDE_EFFORT=high
CLAUDE_TIMEOUT_SECONDS=180
ARTIFACT_DIR=artifacts
