# Use the hackathon key. Never commit the populated .env file.
CLAUDE_HACKATHON_API=
CLAUDE_MODEL=claude-haiku-5-5
# Optional, only for an explicitly trusted Anthropic-compatible endpoint:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MAX_TOKENS=8192
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_SECONDS=180
ARTIFACT_DIR=artifacts

# --- Abstract2Method swarm benchmark (src/a2m) ---
# A2M_DATASET_DIR=/mnt/zgx1-shared/Algo-Discovery-Sim/data/circuit_dataset_300_v1
A2M_TASKS_DIR=data/tasks
A2M_VAULT_DIR=data/vaults
A2M_RUNS_DIR=runs
A2M_JUDGE_MODELS=claude-opus-5-5,claude-sonnet-5-5
